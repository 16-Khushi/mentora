# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Neon Postgres) ---
# Use the pooled connection string from the Neon dashboard.
DATABASE_URL=

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App.
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- AI: NVIDIA Nemotron on Nebius Token Factory ---
NEBIUS_API_KEY=

# --- YouTube ---
# YouTube Data API v3 key (titles, durations, chapters, thumbnails).
YOUTUBE_API_KEY=
# Supadata key (the video's captions).
SUPADATA_API_KEY=
# Requests per second your Supadata plan allows.
SUPADATA_RPS=1

# --- Inngest (background course builds) ---
# Locally: 1, and run `npm run inngest:dev` next to `npm run dev`.
INNGEST_DEV=1
# Production only (from the Inngest dashboard).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- App ---
APP_URL=http://localhost:3000
# Shown on the Terms and Privacy pages and in the footer, for questions and data requests.
NEXT_PUBLIC_CONTACT_EMAIL=
